POSTGRES_PASSWORD=change_me
ADMIN_TOKEN=change_me_admin_token

# Container resource limits (tune for VPS with many services)
DB_CPUS=1.0
DB_MEM=1024m
REDIS_CPUS=0.25
REDIS_MEM=256m
BACKEND_CPUS=1.0
BACKEND_MEM=1024m
WORKER_CPUS=2.0
WORKER_MEM=2048m
FRONTEND_CPUS=0.5
FRONTEND_MEM=256m
NGINX_CPUS=0.25
NGINX_MEM=128m

# Global container log rotation (json-file)
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Used by backend/worker inside docker
DATABASE_URL=postgresql+psycopg2://mosquito:change_me@db:5432/mosquito
REDIS_URL=redis://redis:6379/0

# Paths inside containers
MODEL_PATH=/app/models/saved/best_model.pth
UPLOAD_DIR=/app/data/uploads
LOG_DIR=/app/logs
