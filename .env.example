POSTGRES_PASSWORD=change_me
ADMIN_TOKEN=change_me_admin_token
ALLOW_ADMIN_TOKEN=true

# Secure admin login (recommended)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
SESSION_SECRET=change_me_session_secret_32+chars
COOKIE_SECURE=true

# Container naming prefix (unique per project on VPS)
CONTAINER_PREFIX=mosquito-detect

# Host-published ports (recommend bind to 127.0.0.1 when using host Nginx)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Watchtower (auto update containers by pulling new images)
WATCHTOWER_INTERVAL=30

# Container resource limits (tune for VPS with many services)
DB_CPUS=1.0
DB_MEM=1024m
REDIS_CPUS=0.25
REDIS_MEM=256m
BACKEND_CPUS=1.0
BACKEND_MEM=1024m
WORKER_CPUS=2.0
WORKER_MEM=2048m
FRONTEND_CPUS=0.5
FRONTEND_MEM=256m

# Global container log rotation (json-file)
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Used by backend/worker inside docker
DATABASE_URL=postgresql+psycopg2://mosquito:change_me@db:5432/mosquito
REDIS_URL=redis://redis:6379/0

# Paths inside containers
MODEL_PATH=/app/models/saved/best_model.pth
UPLOAD_DIR=/app/data/uploads
LOG_DIR=/app/logs
